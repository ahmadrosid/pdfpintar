# Copy to .env.local for local development with Docker Compose:
#   cp .env.docker.example .env.local
#
# Start infrastructure:
#   docker compose up -d
#
# Then push schema and run the app on your host:
#   npm run db:push
#   npm run dev

DATABASE_URL=postgresql://pdfpintar:pdfpintar@localhost:5433/pdfpintar
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# MinIO (S3-compatible) — console at http://localhost:9001
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=pdfpintar
AWS_S3_ENDPOINT=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Required for document upload / chat (not provided by Compose)
OPENAI_API_KEY=
OPENAI_ORGANIZATION=

# Optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
REQUIRE_EMAIL_VERIFICATION=false
SUPER_ADMIN_EMAIL=admin@example.com
